# 3. Lua Filter for Cases & Statutes
cat << 'EOF' > _extensions/lex-quarto/lex-filter.lua
local cases = {}
local statutes = {}

function Span(el)
  if el.classes:includes("case") then
    local text = pandoc.utils.stringify(el)
    table.insert(cases, text)
    
    local name, citation = text:match("^(.-)%s+(%[%d+%].*)$")
    if not name then
      name, citation = text:match("^(.-)%s+(%(%d+%).*)$")
    end

    if name and citation then
      return {
        pandoc.Emph({pandoc.Str(name)}),
        pandoc.Space(),
        pandoc.Str(citation)
      }
    else
      return pandoc.Emph(el.content)
    end
  end

  if el.classes:includes("statute") then
    local text = pandoc.utils.stringify(el)
    table.insert(statutes, text)
    return el.content
  end
end

function Pandoc(doc)
  local file = io.open("_lex_authorities.json", "w")
  if file then
    file:write('{\n  "cases": [\n')
    for i, c in ipairs(cases) do
      file:write(string.format('    "%s"%s\n', c:gsub('"', '\\"'), i < #cases and "," or ""))
    end
    file:write('  ],\n  "statutes": [\n')
    for i, s in ipairs(statutes) do
      file:write(string.format('    "%s"%s\n', s:gsub('"', '\\"'), i < #statutes and "," or ""))
    end
    file:write('  ]\n}\n')
    file:close()
  end
  return doc
end
EOF

