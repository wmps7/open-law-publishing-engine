# 6. Python Parser
cat << 'EOF' > cli/lex_cli/parser.py
import json
from pathlib import Path

def generate_tables(json_path="_lex_authorities.json", output_dir="front-matter"):
    path = Path(json_path)
    if not path.exists():
        print("Error: _lex_authorities.json not found. Run 'quarto render' first.")
        return

    data = json.loads(path.read_text(encoding="utf-8"))
    unique_cases = sorted(set(data.get("cases", [])), key=lambda x: x.lower())
    unique_statutes = sorted(set(data.get("statutes", [])), key=lambda x: x.lower())

    out_path = Path(output_dir)
    out_path.mkdir(parents=True, exist_ok=True)

    toc_lines = ["# Table of Cases {.unnumbered}\n"]
    for case in unique_cases:
        toc_lines.append(f"- *{case}*")
    (out_path / "table-of-cases.qmd").write_text("\n".join(toc_lines), encoding="utf-8")

    tos_lines = ["# Table of Statutes {.unnumbered}\n"]
    for statute in unique_statutes:
        tos_lines.append(f"- {statute}")
    (out_path / "table-of-statutes.qmd").write_text("\n".join(tos_lines), encoding="utf-8")

    print(f"Success: Generated {len(unique_cases)} cases and {len(unique_statutes)} statutes.")

if __name__ == "__main__":
    generate_tables()
EOF

